# Keep secrets outside repository. Never put provider keys in Vite client variables.
GEMINI_API_KEY=
# Gemini endpoint can be configured if access changes.
NASAQ_GEMINI_MODEL=gemini-3.8-flash
# Project must match the Firebase client configuration.
FIREBASE_PROJECT_ID=alert-bivouac-nrrhs
# API remains OFF by default. Enable only after approved corpus, privacy review,
# HTTPS gateway / distributed rate limits, and live integration tests.
NASAQ_ENABLE_PUBLIC_API=false
PORT=3000
